{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/.turbo",
			"!**/public",
			"!**/node_modules",
			"!**/dist",
			"!**/.next",
			"!**/build",
			"!**/coverage",
			"!**/generated",
			"!**/.venv",
			"!**/playwright-report",
			"!**/test-results",
			"!**/*.dc.html",
			"!**/*.min.js",
			"!**/vendor",
			"!**/public/pagefind",
			"!**/dist-release"
		]
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"preset": "all",
				"noSolidDestructuredProps": "off",
				"useQwikValidLexicalScope": "off"
			},
			"suspicious": { "preset": "all", "noReactSpecificProps": "off" },
			"security": { "preset": "all" },
			"a11y": { "preset": "all" },
			"performance": {
				"preset": "all",
				"useSolidForComponent": "off",
				"noJsxPropsBind": "off"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"overrides": [
		{
			"includes": [
				"**/src/components/tools/Breadcrumb.tsx",
				"**/src/pages/_document.tsx",
				"**/src/pages/api/concrete/v2/auth/login.ts"
			],
			"linter": {
				"rules": {
					"correctness": { "noUnresolvedImports": "off" }
				}
			}
		},
		{
			"includes": ["**/next.config.*"],
			"linter": {
				"rules": {
					"suspicious": { "noConsole": "off", "useAwait": "off" }
				}
			}
		},
		{
			"includes": ["**/src/components/_shared/auth/LoginButtons.tsx"],
			"linter": {
				"rules": {
					"correctness": { "noProcessGlobal": "off" }
				}
			}
		},
		{
			"includes": ["**/src/pages/_document.tsx"],
			"linter": {
				"rules": {
					"security": {
						"noDangerouslySetInnerHtml": "off"
					}
				}
			}
		},
		{
			"includes": ["**/src/components/team/Profile.tsx"],
			"linter": {
				"rules": {
					"suspicious": {
						"noArrayIndexKey": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.spec.ts",
				"**/*.spec.tsx",
				"**/test/**",
				"**/__tests__/**"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off",
						"noProcessGlobal": "off",
						"noUnresolvedImports": "off"
					},
					"security": { "noSecrets": "off" },
					"performance": { "noAwaitInLoops": "off", "useTopLevelRegex": "off" },
					"suspicious": {
						"noBitwiseOperators": "off",
						"noMisplacedAssertion": "off",
						"noSkippedTests": "off",
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/e2e/**",
				"**/playwright.config.ts",
				"**/playwright.*.config.ts"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off",
						"noProcessGlobal": "off",
						"noUnresolvedImports": "off"
					},
					"security": { "noSecrets": "off" },
					"performance": { "noAwaitInLoops": "off", "useTopLevelRegex": "off" },
					"suspicious": { "noConsole": "off" }
				}
			}
		},
		{
			"includes": [
				"**/scripts/**",
				"**/tools/**",
				"**/*.config.ts",
				"**/*.config.mjs",
				"**/*.config.js"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off",
						"noProcessGlobal": "off",
						"noUnresolvedImports": "off"
					},
					"performance": { "useTopLevelRegex": "off" },
					"suspicious": { "noConsole": "off" }
				}
			}
		},
		{
			"includes": [
				"**/src/server/**",
				"**/apps/server/**",
				"**/apps/worker/**",
				"**/app/**/route.ts",
				"**/src/app/api/**",
				"**/src/pages/api/**"
			],
			"linter": {
				"rules": {
					"correctness": { "noNodejsModules": "off", "noProcessGlobal": "off" },
					"suspicious": { "noConsole": "off" }
				}
			}
		}
	]
}
