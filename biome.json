{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/.turbo",
			"!**/public",
			"!**/node_modules",
			"!**/dist",
			"!**/.next",
			"!next-env.d.ts",
			"!**/build",
			"!**/coverage",
			"!**/generated",
			"!**/.venv",
			"!**/playwright-report",
			"!**/test-results",
			"!**/*.dc.html",
			"!**/*.min.js",
			"!**/vendor",
			"!**/public/pagefind",
			"!**/dist-release"
		]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "all",
			"correctness": {
				"noSolidDestructuredProps": "off",
				"useQwikValidLexicalScope": "off"
			},
			"suspicious": {
				"noReactSpecificProps": "off"
			},
			"performance": {
				"useSolidForComponent": "off",
				"noJsxPropsBind": "off",
				"noAwaitInLoops": "off"
			},
			"style": {
				"noTernary": "off",
				"noNestedTernary": "off",
				"noMagicNumbers": "off",
				"noJsxLiterals": "off",
				"noContinue": "off",
				"noIncrementDecrement": "off",
				"useDestructuring": "off",
				"useExportsLast": "off",
				"useExplicitLengthCheck": "off",
				"useErrorCause": "off",
				"useNamingConvention": "off",
				"useFilenamingConvention": "off",
				"noProcessEnv": "off",
				"noExcessiveLinesPerFile": {
					"level": "on",
					"options": {
						"maxLines": 500
					}
				},
				"noInferrableTypes": "off"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "off",
				"noExcessiveLinesPerFunction": "off"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"overrides": [
		{
			"includes": [
				"**/src/components/tools/Breadcrumb.tsx",
				"**/src/pages/_document.tsx",
				"**/src/pages/api/concrete/v2/auth/login.ts"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noUnresolvedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["**/next.config.*"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off",
						"useAwait": "off"
					}
				}
			}
		},
		{
			"includes": ["**/src/components/_shared/auth/LoginButtons.tsx"],
			"linter": {
				"rules": {
					"correctness": {
						"noProcessGlobal": "off"
					}
				}
			}
		},
		{
			"includes": ["**/src/pages/_document.tsx"],
			"linter": {
				"rules": {
					"security": {
						"noDangerouslySetInnerHtml": "off"
					}
				}
			}
		},
		{
			"includes": ["**/src/pages/api/concrete/mods/recommended.ts"],
			"linter": {
				"rules": {
					"security": {
						"noSecrets": "off"
					}
				}
			}
		},
		{
			"includes": ["**/src/components/team/Profile.tsx"],
			"linter": {
				"rules": {
					"suspicious": {
						"noArrayIndexKey": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.spec.ts",
				"**/*.spec.tsx",
				"**/test/**",
				"**/__tests__/**"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off",
						"noProcessGlobal": "off",
						"noUnresolvedImports": "off"
					},
					"security": {
						"noSecrets": "off"
					},
					"performance": {
						"noAwaitInLoops": "off",
						"useTopLevelRegex": "off"
					},
					"suspicious": {
						"noBitwiseOperators": "off",
						"noMisplacedAssertion": "off",
						"noSkippedTests": "off",
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/e2e/**",
				"**/playwright.config.ts",
				"**/playwright.*.config.ts"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off",
						"noProcessGlobal": "off",
						"noUnresolvedImports": "off"
					},
					"security": {
						"noSecrets": "off"
					},
					"performance": {
						"noAwaitInLoops": "off",
						"useTopLevelRegex": "off"
					},
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/scripts/**",
				"tools/**",
				"**/*.config.ts",
				"**/*.config.mjs",
				"**/*.config.js"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off",
						"noProcessGlobal": "off",
						"noUnresolvedImports": "off"
					},
					"performance": {
						"useTopLevelRegex": "off"
					},
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/src/server/**",
				"**/apps/server/**",
				"**/apps/worker/**",
				"**/app/**/route.ts",
				"**/src/app/api/**",
				"**/src/pages/api/**"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off",
						"noProcessGlobal": "off"
					},
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["**/src/pages/**", "next.config.*"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		}
	]
}
